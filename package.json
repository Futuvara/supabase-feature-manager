{
  "name": "supabase-feature-manager",
  "displayName": "Supabase Feature Manager",
  "description": "Manage and execute project features from Supabase with Claude Code integration and AI-powered prompt improvements",
  "version": "1.0.0",
  "publisher": "your-publisher-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/supabase-feature-manager"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "supabase",
    "features",
    "claude",
    "ai",
    "prompt"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "supabase-features",
          "title": "Supabase Features",
          "icon": "media/database-icon.svg"
        }
      ]
    },
    "views": {
      "supabase-features": [
        {
          "type": "webview",
          "id": "supabaseFeatures.enhancedSidebar",
          "name": "Features Manager",
          "icon": "$(code)",
          "contextualTitle": "Supabase Features Manager"
        }
      ]
    },
    "commands": [
      {
        "command": "my-first-extension.login",
        "title": "Supabase: Login"
      },
      {
        "command": "my-first-extension.refreshFeatures",
        "title": "Refresh Features"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^11.7.5",
    "typescript": "^4.9.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.81.1",
    "axios": "^1.13.2"
  }
}
